tainer\">\n\t\t\t\t<div class=\"elementor-element elementor-element-041483d elementor-widget elementor-widget-heading\" data-id=\"041483d\" data-element_type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<h2 class=\"elementor-heading-title elementor-size-default\">Gentle Yoga\n<\/h2>\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-b47008d elementor-widget elementor-widget-text-editor\" data-id=\"b47008d\" data-element_type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<p>New to Yoga, or haven&#8217;t done it for a while; this is the class for you. You will be guided through the general postures of Yoga, to increase flexibility and strength, as well as improve your breathing.<\/p>\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-4753dac e-con-full e-flex e-con e-child\" data-id=\"4753dac\" data-element_type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t<div class=\"elementor-element elementor-element-d9dbb93 e-con-full e-flex e-con e-child\" data-id=\"d9dbb93\" data-element_type=\"container\">\n\t\t<div class=\"elementor-element elementor-element-b4d5145 e-con-full e-flex e-con e-child\" data-id=\"b4d5145\" data-element_type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-78a83a2 e-con-full e-flex e-con e-child\" data-id=\"78a83a2\" data-element_type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-337981f elementor-widget elementor-widget-heading\" data-id=\"337981f\" data-element_type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<h2 class=\"elementor-heading-title elementor-size-default\">Yin<\/h2>\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-41f68a1 elementor-widget elementor-widget-text-editor\" data-id=\"41f68a1\" data-element_type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<section id=\"comp-ktma2qsq\" class=\"comp-ktma2qsq CohWsy wixui-column-strip\"><div class=\"V5AUxf\" data-testid=\"columns\"><div id=\"comp-ktma2qzo\" class=\"comp-ktma2qzo YzqVVZ wixui-column-strip__column\"><div class=\"\" data-mesh-id=\"comp-ktma2qzoinlineContent\" data-testid=\"inline-content\"><div data-mesh-id=\"comp-ktma2qzoinlineContent-gridContainer\" data-testid=\"mesh-container-content\"><div id=\"comp-ktma2qzq1\" class=\"HcOXKn c9GqVL QxJLC3 lq2cno YQcXTT comp-ktma2qzq1 wixui-rich-text\" data-testid=\"richTextElement\"><p class=\"font_7 wixui-rich-text__text\"><span class=\"wixui-rich-text__text\">Yin Yoga is a gentle class with lots of stretching. Combined with breathing this class will soften the tightness in your muscles, joints, ligaments and fascia encouraging better circulation and flexibility. This class will also help you quiet the mind and leave you feeling relaxed and rejuvenated.\u00a0<\/span><\/p><\/div><\/div><\/div><\/div><\/div><\/section><section id=\"comp-ktma2qsm\" class=\"comp-ktma2qsm CohWsy wixui-column-strip\"><div id=\"bgLayers_comp-ktma2qsm\" class=\"if7Vw2\" data-hook=\"bgLayers\" data-motion-part=\"BG_LAYER comp-ktma2qsm\">\u00a0<\/div><\/section>\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-c95bb0c e-con-full e-flex e-con e-child\" data-id=\"c95bb0c\" data-element_type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t<div class=\"elementor-element elementor-element-b32accc e-con-full e-flex e-con e-child\" data-id=\"b32accc\" data-element_type=\"container\">\n\t\t<div class=\"elementor-element elementor-element-c2228f7 e-con-full e-flex e-con e-child\" data-id=\"c2228f7\" data-element_type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-faeb051 e-con-full e-flex e-con e-child\" data-id=\"faeb051\" data-element_type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-ed7649a elementor-widget elementor-widget-heading\" data-id=\"ed7649a\" data-element_type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<h2 class=\"elementor-heading-title elementor-size-default\">Hatha Yoga<\/h2>\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-c1eafda elementor-widget elementor-widget-text-editor\" data-id=\"c1eafda\" data-element_type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<div id=\"comp-ktma2qy62\" class=\"comp-ktma2qy62 YzqVVZ wixui-column-strip__column\"><div class=\"\" data-mesh-id=\"comp-ktma2qy62inlineContent\" data-testid=\"inline-content\"><div data-mesh-id=\"comp-ktma2qy62inlineContent-gridContainer\" data-testid=\"mesh-container-content\"><div id=\"comp-ktma2qya\" class=\"HcOXKn c9GqVL QxJLC3 lq2cno YQcXTT comp-ktma2qya wixui-rich-text\" data-testid=\"richTextElement\"><p class=\"font_7 wixui-rich-text__text\"><span class=\"wixui-rich-text__text\">Hatha Yoga classes emphasis is on you moving your body slowly and deliberately into different poses that challenge your strength and flexibility, while at the same time focusing on relaxation and mindfulness. It helps to reduce stress, increase core strength and stability and improves your bodies flexibility.<\/span><\/p><p class=\"font_7 wixui-rich-text__text\"><span class=\"wixui-rich-text__text\">This class is suitable for beginners and can be challenging for long time practitioners.<\/span><\/p><\/div><\/div><\/div><\/div><div id=\"comp-ktma2qyd\" class=\"comp-ktma2qyd YzqVVZ wixui-column-strip__column\"><div id=\"bgLayers_comp-ktma2qyd\" class=\"MW5IWV\" data-hook=\"bgLayers\" data-motion-part=\"BG_LAYER comp-ktma2qyd\">\u00a0<\/div><\/div>\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-314871e e-con-full e-flex e-con e-child\" data-id=\"314871e\" data-element_type=\"container\">\n\t\t<div class=\"elementor-element elementor-element-e0ff444 e-con-full e-flex e-con e-child\" data-id=\"e0ff444\" data-element_type=\"container\">\n\t\t<div class=\"elementor-element elementor-element-3138697 e-con-full e-flex e-con e-child\" data-id=\"3138697\" data-element_type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-11f33d8 e-con-full e-flex e-con e-child\" data-id=\"11f33d8\" data-element_type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-3592ac2 elementor-widget elementor-widget-heading\" data-id=\"3592ac2\" data-element_type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<h2 class=\"elementor-heading-title elementor-size-default\">Infrared Hot Yoga\n<\/h2>\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-b2aae32 elementor-widget elementor-widget-text-editor\" data-id=\"b2aae32\" data-element_type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<section id=\"comp-ktma2qsm\" class=\"comp-ktma2qsm CohWsy wixui-column-strip\"><div class=\"V5AUxf\" data-testid=\"columns\"><div id=\"comp-ktma2qye1\" class=\"comp-ktma2qye1 YzqVVZ wixui-column-strip__column\"><div class=\"\" data-mesh-id=\"comp-ktma2qye1inlineContent\" data-testid=\"inline-content\"><div data-mesh-id=\"comp-ktma2qye1inlineContent-gridContainer\" data-testid=\"mesh-container-content\"><div id=\"comp-ktma2qyh\" class=\"HcOXKn c9GqVL QxJLC3 lq2cno YQcXTT comp-ktma2qyh wixui-rich-text\" data-testid=\"richTextElement\"><p class=\"font_7 wixui-rich-text__text\"><span class=\"wixui-rich-text__text\">Our Infrared Heated Yoga classes are designed in a therapeutic sequence to build strength, develop flexibility and cultivate a deeper awareness of the breath. <\/span><span class=\"wixui-rich-text__text\">This class is heated around 30 deg C with Infrared heaters ( same heaters used for infrared saunas ).This class will assist with detoxifying the body, build strength and resilience and quiet the mind, while reducing inflammation in the body.<\/span><\/p><\/div><\/div><\/div><\/div><\/div><\/section><section id=\"comp-ktma2qs1\" class=\"comp-ktma2qs1 CohWsy wixui-column-strip\"><div id=\"bgLayers_comp-ktma2qs1\" class=\"if7Vw2\" data-hook=\"bgLayers\" data-motion-part=\"BG_LAYER comp-ktma2qs1\">\u00a0<\/div><\/section>\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-f7d077a e-con-full e-flex e-con e-child\" data-id=\"f7d077a\" data-element_type=\"container\">\n\t\t<div class=\"elementor-element elementor-element-fbbc94d e-con-full e-flex e-con e-child\" data-id=\"fbbc94d\" data-element_type=\"container\">\n\t\t<div class=\"elementor-element elementor-element-e34a61d e-con-full e-flex e-con e-child\" data-id=\"e34a61d\" data-element_type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-e4b121f e-con-full e-flex e-con e-child\" data-id=\"e4b121f\" data-element_type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-ad67035 elementor-widget elementor-widget-heading\" data-id=\"ad67035\" data-element_type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<h2 class=\"elementor-heading-title elementor-size-default\">Slow Flow<\/h2>\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-f572a57 elementor-widget elementor-widget-text-editor\" data-id=\"f572a57\" data-element_type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<p class=\"font_7 wixui-rich-text__text\"><span class=\"wixui-rich-text__text\">Our Slow Flow class is a Hatha inspired completely guided practice that flows with breath. This class builds strength and flexibility and allows students to flow between poses in a rhythmic motion creating a meditative state; which will leave you feeling\u00a0grounded and rejuvenated.<\/span><\/p><p class=\"font_7 wixui-rich-text__text\"><span class=\"wixui-rich-text__text\">Suitable for all levels<\/span><\/p>\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-e8b96d6 e-con-full e-flex e-con e-child\" data-id=\"e8b96d6\" data-element_type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t<div class=\"elementor-element elementor-element-04a95e8 e-con-full e-flex e-con e-child\" data-id=\"04a95e8\" data-element_type=\"container\">\n\t\t<div class=\"elementor-element elementor-element-22e6219 e-con-full e-flex e-con e-child\" data-id=\"22e6219\" data-element_type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-73bc6aa e-con-full e-flex e-con e-child\" data-id=\"73bc6aa\" data-element_type=\"container\">\n\t\t\t\t<div class=\"elementor-element elementor-element-b7262dc elementor-widget elementor-widget-heading\" data-id=\"b7262dc\" data-element_type=\"widget\" data-widget_type=\"heading.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t<h2 class=\"elementor-heading-title elementor-size-default\">Sunrise Yoga<\/h2>\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<div class=\"elementor-element elementor-element-0890699 elementor-widget elementor-widget-text-editor\" data-id=\"0890699\" data-element_type=\"widget\" data-widget_type=\"text-editor.default\">\n\t\t\t\t<div class=\"elementor-widget-container\">\n\t\t\t\t\t\t\t\t\t<section id=\"comp-ktma2qs1\" class=\"comp-ktma2qs1 CohWsy wixui-column-strip\"><div class=\"V5AUxf\" data-testid=\"columns\"><div id=\"comp-ktma2quh\" class=\"comp-ktma2quh YzqVVZ wixui-column-strip__column\"><div class=\"\" data-mesh-id=\"comp-ktma2quhinlineContent\" data-testid=\"inline-content\"><div data-mesh-id=\"comp-ktma2quhinlineContent-gridContainer\" data-testid=\"mesh-container-content\"><div id=\"comp-ktma2quk1\" class=\"HcOXKn c9GqVL QxJLC3 lq2cno YQcXTT comp-ktma2quk1 wixui-rich-text\" data-testid=\"richTextElement\"><p class=\"font_7 wixui-rich-text__text\"><span class=\"wixui-rich-text__text\">Get off to a good start to the day with our Sunrise Yoga class. This is a Hatha style class combining movement to wake the body up and get it ready for the day ahead.\u00a0<\/span><\/p><p class=\"font_7 wixui-rich-text__text\"><span class=\"wixui-rich-text__text\">This class will leave you feeling recharged and rejuvenated.\u00a0<\/span><\/p><p class=\"font_7 wixui-rich-text__text\"><span class=\"wixui-rich-text__text\">Suitable for all levels.<\/span><\/p><\/div><\/div><\/div><\/div><\/div><\/section>\t\t\t\t\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t\t\t<\/div>\n\t\t<div class=\"elementor-element elementor-element-c42cb66 e-con-full e-flex e-con e-child\" data-id=\"c42cb66\" data-element_type=\"container\" data-settings=\"{&quot;background_background&quot;:&quot;classic&quot;}\">\n\t\t<div class=\"elementor-element eleme